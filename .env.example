# Runtime data directory. The catalog seed is read-only; runtime.store.json is mutable.
VECTRA_DATA_DIR=./data

# Optional overrides. Defaults come from data/catalog.seed.json.
VECTRA_DELIVERY_FEE_CENTS=50000
VECTRA_RETENTION_DAYS=30

# Keep the MVP on a single Node instance with a persistent disk.
NODE_ENV=development
